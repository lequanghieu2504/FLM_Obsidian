    },
    {
      "No.": "2",
      "CLO Name": "CLO2",
      "CLO Details": "Vận dụng được kiến thức chữ Hán thông dụng để đọc tài liệu học tập, nghiên cứu, làm việc… liên quan đến tiếng Hàn."
    },
    {
      "No.": "3",
      "CLO Name": "CLO3",
      "CLO Details": "Sử dụng, viết được chữ Hán thông dung trong một số loại văn bản tiếng Hàn (luận văn, bài nghiên cứu, bài báo khoa học, báo cáo...)."
    },
    {
      "No.": "4",
      "CLO Name": "CLO4",
      "CLO Details": "Nhận biết và có kĩ năng phân tích, tra tự điển chữ Hán, từ điển từ Hán Hàn."
    },
    {
      "No.": "5",
      "CLO Name": "CLO5",
      "CLO Details": "Vận dụng kiến thức đã học để tự trau dồi tiếp, nâng cao trình độ, có thể nghiên cứu tác phẩm văn học cổ trung đại, di sản văn hóa, di tích lịch sử… có chữ Hán trong đó."
    },
    {
      "No.": "6",
      "CLO Name": "CLO6",
      "CLO Details": "Nhận thức được tầm quan trọng của học phần Hán tự tiếng Hàn, có ý thức tự học, rèn luyện trên lớp và ở nhà."
    }
  ],
