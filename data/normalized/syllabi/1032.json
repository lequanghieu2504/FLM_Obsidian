  "learning_outcomes": [
    {
      "No.": "1",
      "CLO Name": "CLO1",
      "CLO Details": "Manipulate logical expressions and use logic for inference and proofs"
    },
    {
      "No.": "2",
      "CLO Name": "CLO2",
      "CLO Details": "Perform basic operations on sets, functions and sequences"
    },
    {
      "No.": "3",
      "CLO Name": "CLO3",
      "CLO Details": "Analyze basic algorithms written in pseudo codes and determine theirs complexities"
    },
    {
      "No.": "4",
      "CLO Name": "CLO4",
      "CLO Details": "Discuss applications of modular arithmetic and analyze algorithms on integers"
    },
    {
      "No.": "5",
      "CLO Name": "CLO5",
      "CLO Details": "Use induction and recursive definition to prove a statement or to describe an object, and write recursive algorithms"
    },
    {
      "No.": "6",
      "CLO Name": "CLO6",
      "CLO Details": "Solve counting problems"
    },
    {
      "No.": "7",
      "CLO Name": "CLO7",
      "CLO Details": "Analyze recurrence relations"
    }
  ],
