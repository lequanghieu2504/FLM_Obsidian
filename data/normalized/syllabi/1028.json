  "learning_outcomes": [
    {
      "No.": "1",
      "CLO Name": "CLO1",
      "CLO Details": "Solve a system of linear equations using Gaussian elimination"
    },
    {
      "No.": "2",
      "CLO Name": "CLO2",
      "CLO Details": "Perform basic operations on matrices and manipulate matrix transformations"
    },
    {
      "No.": "3",
      "CLO Name": "CLO3",
      "CLO Details": "Find the determinant, inverse and diagonalization of a matrix"
    },
    {
      "No.": "4",
      "CLO Name": "CLO4",
      "CLO Details": "Use vector operations to analyze and describe geometric onjects in the spaces R^2 and R^3"
    },
    {
      "No.": "5",
      "CLO Name": "CLO5",
      "CLO Details": "Find the dimension and bases of a subspace in R^n"
    },
    {
      "No.": "6",
      "CLO Name": "CLO6",
      "CLO Details": "Find the dimension and bases of an abstract vector subpace."
    },
    {
      "No.": "7",
      "CLO Name": "CLO7",
      "CLO Details": "Analyze linear transformations between two vector spaces"
    },
    {
      "No.": "8",
      "CLO Name": "CLO8",
      "CLO Details": "Carry out orthogonalization process and use orthogonality to solve applications."
    }
  ],
