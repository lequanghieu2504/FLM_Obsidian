      "CLO Name": "CLO2",
      "CLO Details": "Explain the issue of concurrency programming, thread Synchronization and Wait/Notify mechanism"
    },
    {
      "No.": "3",
      "CLO Name": "CLO3",
      "CLO Details": "Discuss the role of JFC and Swing and applies the use of swing components to create a GUI application"
    },
    {
      "No.": "4",
      "CLO Name": "CLO4",
      "CLO Details": "Applies the use of swing layout for designing a window application"
    },
    {
      "No.": "5",
      "CLO Name": "CLO5",
      "CLO Details": "Applies the event handling for writing event listeners for swing components"
    },
    {
      "No.": "6",
      "CLO Name": "CLO6",
      "CLO Details": "Explain how to program network application using Socket API and RMI"
    },
    {
      "No.": "7",
      "CLO Name": "CLO7",
      "CLO Details": "Demonstrates how to display and print 2D graphics in your Java programs"
    },
    {
      "No.": "8",
      "CLO Name": "CLO8",
      "CLO Details": "Demonstrates the use of JDBC to execute common SQL statements, and perform other objectives common to database applications."
    },
    {
      "No.": "9",
      "CLO Name": "CLO9",
      "CLO Details": "Demonstrates how to internationalize Java applications"
    }
